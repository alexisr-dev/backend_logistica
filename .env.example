SECRET_KEY=cambia-esto
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=logistica
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
OSRM_URL=https://router.project-osrm.org

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Email. Sin EMAIL_HOST_USER/EMAIL_HOST_PASSWORD se usa el backend de consola:
# los correos se imprimen en el terminal del backend, que es lo que hace falta
# en desarrollo. Con Gmail hace falta 2FA activo + una "contraseña de aplicación"
# (la contraseña normal de la cuenta no funciona).
# Déjalos VACÍOS salvo que vayas a enviar correo real: si ambos tienen valor
# el backend activa SMTP. Ejemplo con Gmail:
#   EMAIL_HOST_USER=tu_correo@gmail.com
#   EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Recuperación de contraseña
PASSWORD_RESET_CODIGO_MINUTOS=15
PASSWORD_RESET_MAX_INTENTOS=5

CELERY_ENABLED=False
